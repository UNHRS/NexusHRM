generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  employees     Employee[]
  jobOpenings   JobOpening[]
  announcements Announcement[]
  createdAt     DateTime       @default(now())
}

model Employee {
  id              Int                @id @default(autoincrement())
  fullName        String
  email           String             @unique
  phone           String?
  designation     String
  joiningDate     DateTime
  department      Department         @relation(fields: [departmentId], references: [id])
  departmentId    Int
  managerId       Int?
  manager         Employee?          @relation("ManagerReports", fields: [managerId], references: [id])
  reports         Employee[]         @relation("ManagerReports")
  user            User?
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  salaryStructure SalaryStructure?
  payslips        Payslip[]
  documents       EmployeeDocument[]
  announcements   Announcement[]     @relation("AnnouncementAuthor")
  auditLogs       AuditLog[]         @relation("AuditActor")
  createdAt       DateTime           @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  employee     Employee @relation(fields: [employeeId], references: [id])
  employeeId   Int      @unique
  createdAt    DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Attendance {
  id         Int              @id @default(autoincrement())
  employee   Employee         @relation(fields: [employeeId], references: [id])
  employeeId Int
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)

  @@unique([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  employee   Employee    @relation(fields: [employeeId], references: [id])
  employeeId Int
  leaveType  LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  approvedBy Int?
  createdAt  DateTime    @default(now())
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobOpening {
  id             Int            @id @default(autoincrement())
  title          String
  department     Department     @relation(fields: [departmentId], references: [id])
  departmentId   Int
  location       String
  employmentType EmploymentType @default(FULL_TIME)
  status         JobStatus      @default(OPEN)
  description    String?
  candidates     Candidate[]
  createdAt      DateTime       @default(now())
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model Candidate {
  id           Int            @id @default(autoincrement())
  fullName     String
  email        String
  phone        String?
  source       String?
  stage        CandidateStage @default(APPLIED)
  jobOpening   JobOpening     @relation(fields: [jobOpeningId], references: [id])
  jobOpeningId Int
  notes        String?
  createdAt    DateTime       @default(now())
}

model SalaryStructure {
  id            Int      @id @default(autoincrement())
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    Int      @unique
  basicSalary   Decimal  @db.Decimal(10, 2)
  allowances    Decimal  @default(0) @db.Decimal(10, 2)
  effectiveFrom DateTime @db.Date
}

model PayrollRun {
  id          Int           @id @default(autoincrement())
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)
  generatedAt DateTime      @default(now())
  payslips    Payslip[]

  @@unique([month, year])
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

model Payslip {
  id              Int        @id @default(autoincrement())
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollRunId    Int
  employee        Employee   @relation(fields: [employeeId], references: [id])
  employeeId      Int
  basicSalary     Decimal    @db.Decimal(10, 2)
  allowances      Decimal    @db.Decimal(10, 2)
  workingDays     Int
  presentDays     Decimal    @db.Decimal(4, 1)
  unpaidLeaveDays Decimal    @default(0) @db.Decimal(4, 1)
  lateDeduction   Decimal    @default(0) @db.Decimal(10, 2)
  grossPay        Decimal    @db.Decimal(10, 2)
  totalDeductions Decimal    @db.Decimal(10, 2)
  netPay          Decimal    @db.Decimal(10, 2)

  @@unique([payrollRunId, employeeId])
}

model Holiday {
  id   Int      @id @default(autoincrement())
  name String
  date DateTime @unique @db.Date
  year Int
}

model EmployeeDocument {
  id         Int          @id @default(autoincrement())
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId Int
  docType    DocumentType
  fileName   String
  filePath   String
  uploadedAt DateTime     @default(now())
  expiryDate DateTime?    @db.Date
}

enum DocumentType {
  CITIZENSHIP
  PASSPORT
  CONTRACT
  OFFER_LETTER
  WORK_PERMIT
  OTHER
}

model Announcement {
  id           Int         @id @default(autoincrement())
  title        String
  body         String
  postedBy     Employee    @relation("AnnouncementAuthor", fields: [postedById], references: [id])
  postedById   Int
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?
  createdAt    DateTime    @default(now())
  expiresAt    DateTime?
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actor      Employee? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId    Int?
  action     String
  targetType String
  targetId   Int
  metadata   Json?
  createdAt  DateTime @default(now())
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}
